{
    "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
    "css": {
        "parser": {
            "cssModules": true,
            "tailwindDirectives": true
        }
    },
    "files": {
        "includes": [
            "**",
            "!.metadata.json",
            // BEGIN GENERATED LINT EXCLUDES: biome
            "!!skills-beta/cascade",
            "!!skills-beta/code-storage",
            "!!skills-beta/flint-chart-author",
            "!!skills-beta/flint-theme-author",
            "!!skills-beta/frontend-design",
            "!!skills-beta/herdr",
            "!!skills-beta/ip-as-logo-skill",
            "!!skills-beta/sherlog",
            "!!skills-beta/show-me",
            "!!skills-beta/typesafe-ai",
            "!!skillshare",
            // END GENERATED LINT EXCLUDES: biome
            "!!.mise/locks"
        ],
        "ignoreUnknown": true
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double"
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "style": {
                "useConst": "off"
            }
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "vcs": {
        "clientKind": "git",
        "enabled": true,
        "useIgnoreFile": true
    }
}
